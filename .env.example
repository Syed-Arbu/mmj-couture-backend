# Copy this file to .env and fill in real values before going live.

# Port the server listens on (most hosts set this for you automatically)
PORT=3000

# A long random string used to sign login sessions.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Set to "production" when deployed live (makes login cookies HTTPS-only)
NODE_ENV=production

# Leave blank unless the frontend is hosted on a different domain than the backend
CORS_ORIGIN=
